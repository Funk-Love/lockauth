# 运行环境：production / development（旧变量名 FLASK_ENV 仍然认）
APP_ENV=production

# 数据库：不填就是 instance/auth.db
# DATABASE_URL=sqlite:///auth.db

# JWT 密钥：必须和旧版同一把，否则所有人都会被登出
JWT_SECRET_KEY=your-jwt-secret-key-here

# 发信（163 邮箱：465 + SSL）
MAIL_SERVER=smtp.163.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=your-email@163.com
MAIL_PASSWORD=your-smtp-authorization-code
MAIL_DEFAULT_SENDER=Funk & Love <your-email@163.com>
# 本地调试时不真的发信，验证码打印在日志里
# MAIL_SUPPRESS_SEND=true

# 允许跨域调用的前端（LockAI 前端会直接从浏览器调 verify-token）
CORS_ORIGINS=https://auth.funk-and.love,https://ai.funk-and.love,https://cloud.funk-and.love

# 登录后允许跳回的地址；通配只匹配一级子域
ALLOWED_REDIRECT_URIS=https://funk-and.love,https://auth.funk-and.love,https://ai.funk-and.love,https://cloud.funk-and.love,https://*.funk-and.love

# 认证前端地址（/api/auth/sso/config 返回给其他服务）
SSO_FRONTEND_URL=https://auth.funk-and.love

# 头像：阿里云 OSS 公共资源桶 lock-publicfiles（杭州），avatars/ 目录公开可读
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_PUBLIC_BUCKET=lock-publicfiles
# 签名上传地址给浏览器用，走外网
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 服务器在杭州时填内网，本地开发留空
OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
PUBLIC_FILES_URL=https://lock-publicfiles.oss-cn-hangzhou.aliyuncs.com

# 登录记录保留天数
# AUDIT_RETENTION_DAYS=180
